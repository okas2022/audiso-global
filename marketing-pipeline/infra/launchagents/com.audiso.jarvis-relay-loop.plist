<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.audiso.jarvis-relay-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>export JARVIS_ROOT=/Users/Mac/Audiso/marketing-pipeline AUDISO_GLOBAL=/Users/Mac/Audiso/audiso-global HOME=/Users/Mac PATH=/Users/Mac/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin; cd /Users/Mac/Audiso/audiso-global &amp;&amp; git fetch origin main &amp;&amp; git pull --ff-only origin main; exec bash /Users/Mac/Audiso/audiso-global/marketing-pipeline/scripts/mac-suno-force-now.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/Mac/Audiso/marketing-pipeline/pipeline_data/jarvis_memory/episodes/relay-loop-launchagent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Mac/Audiso/marketing-pipeline/pipeline_data/jarvis_memory/episodes/relay-loop-launchagent.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>JARVIS_ROOT</key>
    <string>/Users/Mac/Audiso/marketing-pipeline</string>
    <key>AUDISO_GLOBAL</key>
    <string>/Users/Mac/Audiso/audiso-global</string>
    <key>HOME</key>
    <string>/Users/Mac</string>
    <key>GOOGLE_DRIVE_REQUIRED_ACCOUNT</key>
    <string>okas2000@gmail.com</string>
    <key>SUNO_USE_DEFAULT_CHROME_PROFILE</key>
    <string>1</string>
    <key>PATH</key>
    <string>/Users/Mac/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
