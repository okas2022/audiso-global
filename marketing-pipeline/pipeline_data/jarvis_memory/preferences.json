{
  "stt": "local",
  "tts": "local",
  "nlu": "gemini",
  "no_openai_voice": true,
  "no_env_secrets_in_memory": true,
  "unified_cloud_entry": true,
  "primary_prompt_surface": "cloud-mobile-pro",
  "effective_workspace": "/Users/Mac/Audiso/marketing-pipeline",
  "policy": "mac_local_first",
  "relay_only": true,
  "main_computer": "MacBook Pro (office) — /Users/Mac/Audiso/marketing-pipeline",
  "command_surfaces": ["cloud-mobile-pro", "iphone-pro", "macbook-air"],
  "never_delete_mac_local_for_git_dedup": true,
  "zero_capability_loss": true,
  "agents_registry": "pipeline_data/jarvis_memory/agents_registry.json",
  "dispatch_script": "scripts/jarvis-dispatch.sh",
  "mac_tasks_by_mac_cursor": true,
  "never_ask_ceo_to_run_mac_terminal": true,
  "mac_agent_root": "/Users/Mac/Audiso/marketing-pipeline",
  "mac_task_queue": "pipeline_data/jarvis_memory/mac_tasks/",
  "mac_only_delegates": ["ssd_mount", "launchagent", "local_stt_tts", "browser_automation", "mac_local_execution"],
  "git_sync": {
    "scope": "code_only",
    "policy": "mac_local_first",
    "note": "pipeline_data bulk stays on MacBook Pro local. Git syncs scripts/rules/small jarvis JSON only.",
    "target_repo": "github.com/okas2022/audiso-global",
    "target_path": "marketing-pipeline/",
    "mac_push_script": "scripts/mac-git-sync-push.sh",
    "cloud_pull_script": "scripts/cloud-git-sync-pull.sh",
    "exclude": ["pipeline_data/assets/", "pipeline_data/naver_drafts/", "oauth tokens", "chrome profiles", "sqlite"]
  },
  "relay_loop": {
    "enabled": true,
    "interval_seconds": 300,
    "cloud_script": "scripts/cloud-prompt-relay.sh",
    "mac_script": "scripts/mac-jarvis-relay-loop.sh",
    "mac_launchagent": "infra/launchagents/com.audiso.jarvis-relay-loop.plist",
    "note": "Phone/MacBook Air/Cloud prompt → git mac_tasks → MacBook Pro 24h executes"
  },
  "my_machines": {
    "enabled": true,
    "worker_name": "macbook-pro-audiso",
    "worker_dir": "/Users/Mac/Audiso/marketing-pipeline",
    "auto_start_script": "scripts/mac-cursor-worker-start.sh",
    "mode": "prompt_relay",
    "note": "Cloud does not replace Mac execution. User prompts here → worker runs on MacBook Pro local paths."
  },
  "music_pipeline": {
    "enabled": true,
    "root": "pipeline_data/assets/music/",
    "brief_template": "pipeline_data/jarvis_memory/templates/music_brief.json",
    "checklist_stages": "pipeline_data/jarvis_memory/templates/music_checklist_stages.json",
    "providers_config": "pipeline_data/jarvis_memory/music_providers.json",
    "catalog": "pipeline_data/assets/music/.track_index/music-catalog.json",
    "track_id_format": "AUD-MUS-YYYYMMDD-NNN",
    "new_track_script": "scripts/music-new-track.sh",
    "checklist_script": "scripts/music-suno-checklist.sh",
    "pipeline_run_script": "scripts/music-pipeline-run.sh",
    "human_evidence_script": "scripts/music-human-evidence.sh",
    "komca_pack_script": "scripts/music-komca-pack.sh",
    "komca_mark_submitted_script": "scripts/music-komca-mark-submitted.sh",
    "copyright_pack_script": "scripts/music-copyright-commission-pack.sh",
    "copyright_mark_submitted_script": "scripts/music-copyright-mark-submitted.sh",
    "isrc_script": "scripts/music-isrc-assign.sh",
    "catalog_report_script": "scripts/music-catalog-report.sh",
    "primary_provider": "suno_downloads_watch",
    "fallback_provider": "elevenlabs_music",
    "suno_watch_script": "scripts/music-suno-inbox-watch.sh",
    "suno_watch_launchagent": "scripts/mac-install-music-watch-launchagent.sh",
    "daw_watch_script": "scripts/music-daw-watch.sh",
    "daw_watch_launchagent": "scripts/mac-install-music-daw-watch-launchagent.sh",
    "catalog_report_launchagent": "scripts/mac-install-music-catalog-report-launchagent.sh",
    "komca_portal_run": "scripts/komca-portal-run.sh",
    "komca_full_automation": "scripts/komca-full-automation.sh",
    "komca_mac_task": "scripts/mac-komca-run-task.sh",
    "episode_prefix": "music-",
    "note": "Phase A–C + KOMCA browser automation on Mac (CEO phone auth only). Trust contract still requires offline docs+200K KRW."
  }
}
